# Copy to .env.local for local development.

# Public site URL (canonical links, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API (healthcare-be); locally `php artisan serve` in WSL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Contact details shown in the header, sticky bar and footer (optional)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Flotiq (read-only API key of the practice's own space)
FLOTIQ_API_URL=https://api.flotiq.com
FLOTIQ_API_KEY=

# Shared secrets: Flotiq preview URL (/api/draft?secret=...) and webhook header (x-revalidate-secret)
DRAFT_MODE_SECRET=
REVALIDATE_SECRET=
