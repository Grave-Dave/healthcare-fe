# Copy to .env.local for local development.

# Public site URL (canonical links, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API (healthcare-be); locally `php artisan serve` in WSL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Contact details shown in the header, sticky bar and footer (optional)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Umami analytics (cloud.umami.is, EU). Loaded only in production builds, outside Flotiq preview and only on the
# NEXT_PUBLIC_SITE_URL domain. Leave empty locally. Production value: 384d8517-04f2-42c1-bfa1-4cbd8b93e529
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Test/staging deployment: 1 = noindex (robots.txt disallow + X-Robots-Tag header)
SITE_NOINDEX=

# Flotiq – read-only API key of the "Terapia" space (also used by `npm run flotiq:types`)
FLOTIQ_API_URL=https://api.flotiq.com
FLOTIQ_API_KEY=

# Shared secrets: Flotiq preview URL (/api/flotiq/draft?key=...) and webhook header (x-revalidate-secret)
DRAFT_MODE_SECRET=
REVALIDATE_SECRET=
